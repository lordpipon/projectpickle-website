{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "redirects": [{ "source": "/device", "destination": "/auth", "permanent": false }],
  "headers": [{ "source": "/assets/config.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
